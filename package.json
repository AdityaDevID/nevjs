{
  "name": "nev-monorepo",
  "private": true,
  "version": "0.2.0",
  "description": "Nev.js — a zero-build JavaScript framework family: NevF (frontend), NevB (backend), NevG (game), Nev (fullstack).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.js\"",
    "test:f": "node --test \"packages/nevf/test/*.test.js\"",
    "test:b": "node --test \"packages/nevb/test/*.test.js\"",
    "test:g": "node --test \"packages/nevg/test/*.test.js\"",
    "test:fullstack": "node --test \"packages/nev/test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  },
  "author": "AdityaDevID",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdityaDevID/nevjs.git"
  },
  "homepage": "https://github.com/AdityaDevID/nevjs#readme"
}
