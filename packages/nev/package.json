{
  "name": "@adityadevid/nevjs",
  "version": "0.6.0",
  "description": "Nev.js — zero-build fullstack framework: file-based routing, SSR, API routes, loaders and client-side navigation, built on NevF + NevB (+ NevG).",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "nev": "./bin/nev.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "client",
    "templates",
    "types"
  ],
  "dependencies": {
    "@adityadevid/nevb": "^0.4.0",
    "@adityadevid/nevf": "^0.4.0",
    "@adityadevid/nevg": "^0.3.0"
  },
  "keywords": [
    "nev",
    "fullstack",
    "ssr",
    "framework",
    "file-based-routing"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "AdityaDevID",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdityaDevID/nevjs.git",
    "directory": "packages/nev"
  },
  "homepage": "https://github.com/AdityaDevID/nevjs#readme",
  "bugs": {
    "url": "https://github.com/AdityaDevID/nevjs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./types/index.d.ts"
}
