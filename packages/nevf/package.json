    "./jsx-dev-runtime": "./src/jsx-dev-runtime.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types"
  ],
  "sideEffects": false,
  "keywords": [
    "nev",
    "nevf",
    "frontend",
    "signals",
    "reactive",
    "ssr"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "AdityaDevID",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdityaDevID/nevjs.git",
    "directory": "packages/nevf"
  },
  "homepage": "https://github.com/AdityaDevID/nevjs#readme",
  "bugs": {
    "url": "https://github.com/AdityaDevID/nevjs/issues"
  },
